generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth) ----------

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  passwordHash    String?
  // "TUTOR" | "STUDENT" | "ADMIN"
  role            String    @default("STUDENT")
  timezone        String    @default("Europe/Prague")
  termsAcceptedAt DateTime?
  // účet byl smazán uživatelem – osobní údaje jsou anonymizované
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts     Account[]
  sessions     Session[]
  tutorProfile TutorProfile?
  enrollments  Enrollment[]  @relation("StudentEnrollments")
  purchases    Purchase[]    @relation("StudentPurchases")
  lessons      Lesson[]      @relation("StudentLessons")
  reviews      Review[]
  messages     Message[]
  files        StoredFile[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Používá se i pro ověření e-mailu (identifier = e-mail, token = hash tokenu).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

// ---------- Lektoři ----------

model TutorProfile {
  id             String  @id @default(cuid())
  userId         String  @unique
  slug           String  @unique
  headline       String  @default("")
  bio            String  @default("")
  // čárkou oddělené kódy jazyků, např. "en,de"
  languages      String  @default("")
  levels         String  @default("")
  city           String?
  videoLink      String?
  published      Boolean @default(false)
  calendarSync   Boolean @default(false)
  // minimální předstih rezervace v hodinách
  minNoticeHours Int     @default(12)
  // do kolika hodin před lekcí může student zrušit bez ztráty lekce
  cancelHours    Int     @default(24)
  // pozastavený administrátorem – nezobrazuje se v katalogu a nelze u něj nakupovat
  suspended      Boolean @default(false)

  // Předplatné platformy (tarif podle počtu studentů), placené převodem na fakturu
  plan            String    @default("FREE")
  // tarif od dalšího období (nižší tarif nebo "FREE" = zrušení předplatného)
  nextPlan        String?
  // do kdy má lektor tarif k dispozici (zaplacené období, nebo lhůta splatnosti faktury)
  planActiveUntil DateTime?
  // konec zaplaceného období
  paidUntil       DateTime?
  billingCurrency String    @default("czk")

  // Fakturační a daňové údaje (faktury za předplatné, hlášení DAC7)
  legalName String?
  street    String?
  cityName  String?
  zip       String?
  country   String    @default("CZ")
  companyId String?
  vatId     String?
  birthDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankAccounts TutorBankAccount[]
  invoices     Invoice[]
  packages     LessonPackage[]
  invitations  Invitation[]
  enrollments  Enrollment[]
  availability Availability[]
  purchases    Purchase[]
  lessons      Lesson[]
  reviews      Review[]
}

// Bankovní účet lektora pro platby studentů – jeden na měnu.
model TutorBankAccount {
  id            String   @id @default(cuid())
  tutorId       String
  // kód měny malými písmeny: czk, eur, usd…
  currency      String
  holderName    String
  // IBAN (preferovaný), nebo číslo účtu pro země bez IBAN (USA…)
  iban          String?
  accountNumber String?
  // SWIFT / BIC – nutný pro platby ze zahraničí
  bic           String?
  bankName      String?
  // doplňující údaje pro mezinárodní platbu (např. ABA routing number, adresa banky)
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)

  @@unique([tutorId, currency])
}

model LessonPackage {
  id           String   @id @default(cuid())
  tutorId      String
  name         String
  description  String   @default("")
  lessonCount  Int
  durationMin  Int      @default(60)
  priceCents   Int
  currency     String   @default("czk")
  isTrial      Boolean  @default(false)
  // platnost balíčku ve dnech od zaplacení (null = bez omezení)
  validityDays Int?
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  purchases Purchase[]
}

model Availability {
  id          String @id @default(cuid())
  tutorId     String
  // 0 = neděle ... 6 = sobota
  weekday     Int
  startMinute Int
  endMinute   Int

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

// ---------- Studenti ----------

model Invitation {
  id         String    @id @default(cuid())
  tutorId    String
  email      String
  token      String    @unique
  message    String?
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id         String    @id @default(cuid())
  tutorId    String
  studentId  String
  // soukromá poznámka lektora o studentovi (úroveň, cíle…)
  notes      String    @default("")
  // archivovaný student se nepočítá do tarifu a nemůže kupovat ani rezervovat
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  tutor    TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student  User         @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([tutorId, studentId])
}

model Purchase {
  id              String    @id @default(cuid())
  tutorId         String
  studentId       String
  packageId       String?
  packageName     String
  lessonsTotal    Int
  durationMin     Int
  amountCents     Int
  currency        String
  // "PENDING" | "PAID" | "REFUNDED" | "CANCELLED"
  status          String    @default("PENDING")
  // "TRANSFER" = převodem (potvrzuje lektor), "MANUAL" = připsal lektor ručně
  source          String    @default("TRANSFER")
  note            String?
  // variabilní symbol / reference platby
  variableSymbol  String?   @unique
  paidAt          DateTime?
  expiresAt       DateTime?
  refundedLessons Int       @default(0)
  refundedCents   Int       @default(0)
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())

  tutor   TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student User           @relation("StudentPurchases", fields: [studentId], references: [id], onDelete: Cascade)
  package LessonPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  lessons Lesson[]

  @@index([tutorId, studentId])
}

model Lesson {
  id             String    @id @default(cuid())
  tutorId        String
  studentId      String
  purchaseId     String
  // pravidelné lekce mají společné seriesId
  seriesId       String?
  startsAt       DateTime
  endsAt         DateTime
  // "SCHEDULED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  status         String    @default("SCHEDULED")
  topic          String    @default("")
  // co se na lekci probíralo
  notes          String    @default("")
  homework       String    @default("")
  googleEventId  String?
  meetLink       String?
  // pořadí změn (pro aktualizaci .ics v kalendáři studenta)
  sequence       Int       @default(0)
  reminderSentAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tutor    TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student  User         @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  purchase Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([tutorId, startsAt])
  @@index([studentId, startsAt])
  @@index([seriesId])
}

model Review {
  id        String   @id @default(cuid())
  tutorId   String
  studentId String
  rating    Int
  comment   String   @default("")
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tutorId, studentId])
}

// ---------- Zprávy a soubory ----------

model Message {
  id           String    @id @default(cuid())
  enrollmentId String
  senderId     String
  body         String    @default("")
  fileId       String?   @unique
  // kdy zprávu přečetl druhý účastník
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  enrollment Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  sender     User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  file       StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@index([enrollmentId, createdAt])
}

// Soubory ukládáme přímo v databázi (avatary, materiály do 5 MB) – bez nutnosti dalšího úložiště.
model StoredFile {
  id        String   @id @default(cuid())
  ownerId   String
  // "AVATAR" | "ATTACHMENT"
  kind      String
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  createdAt DateTime @default(now())

  owner   User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  message Message?
}

// ---------- Fakturace předplatného ----------

// Faktura platformy lektorovi. Zůstává i po smazání účtu lektora (účetnictví) – údaje odběratele jsou ve snímku.
model Invoice {
  id             String    @id @default(cuid())
  // číslo faktury, zároveň variabilní symbol (např. 20260001)
  number         String    @unique
  tutorId        String?
  // "FIRST" = první období, "RENEWAL" = obnova, "UPGRADE" = doplatek za vyšší tarif
  kind           String
  plan           String
  previousPlan   String?
  currency       String
  // celková částka včetně DPH
  amountCents    Int
  vatRate        Int       @default(0)
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime  @default(now())
  dueAt          DateTime
  // "ISSUED" | "PAID" | "EXPIRED" | "CANCELLED"
  status         String    @default("ISSUED")
  paidAt         DateTime?
  reminderSentAt DateTime?
  // kdy se faktura za obnovu promítla do tarifu (začátek nového období)
  appliedAt      DateTime?
  // JSON snímky dodavatele a odběratele v okamžiku vystavení
  supplier       String
  customer       String

  tutor TutorProfile? @relation(fields: [tutorId], references: [id], onDelete: SetNull)

  @@index([tutorId, status])
}

model InvoiceCounter {
  year Int @id
  last Int @default(0)
}

// Demo režim (DEMO_MODE=1): e-maily se místo odeslání ukládají a zobrazují na /demo/posta.
model DemoMail {
  id        String   @id @default(cuid())
  to        String
  subject   String
  text      String
  createdAt DateTime @default(now())

  @@index([createdAt])
}
