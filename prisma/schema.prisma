// Pro produkci přepněte provider na "postgresql" a nastavte DATABASE_URL.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Auth (NextAuth) ----------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  // "TUTOR" | "STUDENT" | "ADMIN"
  role          String    @default("STUDENT")
  timezone      String    @default("Europe/Prague")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  tutorProfile  TutorProfile?
  enrollments   Enrollment[]  @relation("StudentEnrollments")
  purchases     Purchase[]    @relation("StudentPurchases")
  lessons       Lesson[]      @relation("StudentLessons")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

// ---------- Lektoři ----------

model TutorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  slug            String   @unique
  headline        String   @default("")
  bio             String   @default("")
  // čárkou oddělené kódy jazyků, např. "en,de"
  languages       String   @default("")
  levels          String   @default("")
  city            String?
  videoLink       String?
  published       Boolean  @default(false)
  calendarSync    Boolean  @default(false)
  // minimální předstih rezervace v hodinách
  minNoticeHours  Int      @default(12)
  // do kolika hodin před lekcí může student zrušit bez ztráty lekce
  cancelHours     Int      @default(24)
  stripeAccountId String?
  stripeOnboarded Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  packages     LessonPackage[]
  invitations  Invitation[]
  enrollments  Enrollment[]
  availability Availability[]
  purchases    Purchase[]
  lessons      Lesson[]
}

model LessonPackage {
  id          String   @id @default(cuid())
  tutorId     String
  name        String
  description String   @default("")
  lessonCount Int
  durationMin Int      @default(60)
  priceCents  Int
  currency    String   @default("czk")
  isTrial     Boolean  @default(false)
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  tutor     TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  purchases Purchase[]
}

model Availability {
  id          String @id @default(cuid())
  tutorId     String
  // 0 = neděle ... 6 = sobota
  weekday     Int
  startMinute Int
  endMinute   Int

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

// ---------- Studenti ----------

model Invitation {
  id         String    @id @default(cuid())
  tutorId    String
  email      String
  token      String    @unique
  message    String?
  acceptedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  tutor TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model Enrollment {
  id        String   @id @default(cuid())
  tutorId   String
  studentId String
  // soukromá poznámka lektora o studentovi (úroveň, cíle…)
  notes     String   @default("")
  createdAt DateTime @default(now())

  tutor   TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student User         @relation("StudentEnrollments", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([tutorId, studentId])
}

model Purchase {
  id               String    @id @default(cuid())
  tutorId          String
  studentId        String
  packageId        String?
  packageName      String
  lessonsTotal     Int
  durationMin      Int
  amountCents      Int
  platformFeeCents Int
  currency         String
  // "PENDING" | "PAID" | "REFUNDED" | "CANCELLED"
  status           String    @default("PENDING")
  stripeSessionId  String?   @unique
  paidAt           DateTime?
  createdAt        DateTime  @default(now())

  tutor   TutorProfile   @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student User           @relation("StudentPurchases", fields: [studentId], references: [id], onDelete: Cascade)
  package LessonPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  lessons Lesson[]
}

model Lesson {
  id            String   @id @default(cuid())
  tutorId       String
  studentId     String
  purchaseId    String
  startsAt      DateTime
  endsAt        DateTime
  // "SCHEDULED" | "COMPLETED" | "CANCELLED" | "NO_SHOW"
  status        String   @default("SCHEDULED")
  topic         String   @default("")
  // co se na lekci probíralo
  notes         String   @default("")
  homework      String   @default("")
  googleEventId String?
  meetLink      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tutor    TutorProfile @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  student  User         @relation("StudentLessons", fields: [studentId], references: [id], onDelete: Cascade)
  purchase Purchase     @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([tutorId, startsAt])
  @@index([studentId, startsAt])
}
