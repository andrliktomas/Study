# Databáze PostgreSQL (lokálně: docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lektorium"

# Veřejná adresa webu (bez lomítka na konci) – používá se pro SEO, odkazy v e-mailech a na fakturách
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Vygenerujte: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Google OAuth (přihlášení + Google Kalendář) – https://console.cloud.google.com/apis/credentials
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SMTP pro pozvánky a reset hesla (když chybí, odkazy se vypisují do konzole)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Lektorium <noreply@example.com>"

# Údaje provozovatele (obchodní podmínky, GDPR, faktury za předplatné)
OPERATOR_NAME=""
OPERATOR_ID=""
OPERATOR_ADDRESS=""
OPERATOR_EMAIL=""
# např. „Fyzická osoba zapsaná v živnostenském rejstříku“
OPERATOR_REGISTRY=""
# DIČ – vyplňte jen jako plátce DPH (faktury pak obsahují rozpis DPH, sazba OPERATOR_VAT_RATE)
OPERATOR_VAT_ID=""
OPERATOR_VAT_RATE="21"

# Bankovní účty provozovatele pro platby předplatného (stačí jedna měna)
OPERATOR_ACCOUNT_HOLDER=""
OPERATOR_IBAN_CZK=""
OPERATOR_BIC_CZK=""
OPERATOR_BANK_CZK=""
OPERATOR_IBAN_EUR=""
OPERATOR_BIC_EUR=""
OPERATOR_BANK_EUR=""

# Tajný klíč pro /api/cron/reminders (připomínky lekcí a fakturace; volá ho GitHub Actions každou hodinu)
CRON_SECRET=""

# Analytika a Search Console (nepovinné)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
