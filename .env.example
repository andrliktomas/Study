# Databáze (lokálně SQLite, v produkci PostgreSQL)
DATABASE_URL="file:./dev.db"

# Veřejná adresa webu (bez lomítka na konci) – používá se pro SEO, odkazy v e-mailech, Stripe redirecty
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Vygenerujte: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Google OAuth (přihlášení + Google Kalendář) – https://console.cloud.google.com/apis/credentials
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe Connect – platby studentů jdou lektorům, platforma si strhne provizi
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Provize platformy v procentech
PLATFORM_FEE_PERCENT="10"

# SMTP pro pozvánky a reset hesla (když chybí, odkazy se vypisují do konzole)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Lektorium <noreply@example.com>"

# Údaje provozovatele (obchodní podmínky, GDPR, úhrada provizí z ručně připsaných lekcí)
OPERATOR_NAME=""
OPERATOR_ID=""
OPERATOR_ADDRESS=""
OPERATOR_EMAIL=""
OPERATOR_BANK_ACCOUNT=""

# Tajný klíč pro /api/cron/reminders (Vercel Cron ho posílá automaticky jako Bearer token)
CRON_SECRET=""
