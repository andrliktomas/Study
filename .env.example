# Databáze PostgreSQL (lokálně: docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/lektorium"

# Veřejná adresa webu (bez lomítka na konci) – používá se pro SEO, odkazy v e-mailech, Stripe redirecty
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
# Vygenerujte: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"

# Google OAuth (přihlášení + Google Kalendář) – https://console.cloud.google.com/apis/credentials
# Redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe – předplatné lektorů (Billing) a platby studentů přímo na Stripe účty lektorů (Connect Standard)
STRIPE_SECRET_KEY=""
# Webhook pro události platformy (předplatné): {URL}/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=""
# Webhook pro události připojených účtů lektorů (platby lekcí): {URL}/api/stripe/connect-webhook
STRIPE_CONNECT_WEBHOOK_SECRET=""

# SMTP pro pozvánky a reset hesla (když chybí, odkazy se vypisují do konzole)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Lektorium <noreply@example.com>"

# Údaje provozovatele (obchodní podmínky, GDPR)
OPERATOR_NAME=""
OPERATOR_ID=""
OPERATOR_ADDRESS=""
OPERATOR_EMAIL=""

# Tajný klíč pro /api/cron/reminders (Vercel Cron ho posílá automaticky jako Bearer token)
CRON_SECRET=""

# Analytika a Search Console (nepovinné)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
