{
  "name": "lektorium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "make-admin": "tsx scripts/make-admin.ts",
    "vercel-build": "prisma generate && node scripts/vercel-prebuild.mjs && next build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "tsx tests/e2e/reset-db.ts && playwright test"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "2.4.3",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "marked": "14.1.4",
    "next": "15.5.28",
    "next-auth": "4.24.15",
    "nodemailer": "10.3.1",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.56.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.10",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.4.20",
    "eslint": "9.39.1",
    "eslint-config-next": "15.5.28",
    "postcss": "8.5.32",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.17",
    "tsx": "4.23.15",
    "typescript": "5.7.2"
  },
  "overrides": {
    "next-auth": {
      "nodemailer": "$nodemailer"
    },
    "next": {
      "postcss": "$postcss"
    }
  }
}
