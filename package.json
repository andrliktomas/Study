{
  "name": "lektorium",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate",
    "make-admin": "tsx scripts/make-admin.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:e2e": "tsx tests/e2e/reset-db.ts && playwright test"
  },
  "dependencies": {
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "date-fns": "3.6.0",
    "date-fns-tz": "3.2.0",
    "marked": "14.1.4",
    "next": "14.2.35",
    "next-auth": "4.24.11",
    "nodemailer": "6.9.16",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stripe": "17.7.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.17.10",
    "@types/nodemailer": "6.4.17",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
